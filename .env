# AFCS production environment template
# Copy to environment or inject via process manager — do not commit secrets.

AFCS_DB_HOST=127.0.0.1
AFCS_DB_PORT=3307
AFCS_DB_NAME=afcs
AFCS_DB_USER=root
AFCS_DB_PASS=""

# Required in production — used to sign QR tickets
AFCS_HMAC_SECRET=generate_a_long_random_string_here

# Leave empty for same-origin only. Set explicit origin in production if needed.
# AFCS_CORS_ORIGIN=https://afcs.example.com
AFCS_CORS_ORIGIN=

# Optional
# AFCS_APP_ENV=production
